{
  "title": "Depop Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "query": { "title": "Search query", "type": "string", "description": "What to search Depop for.", "editor": "textfield", "prefill": "carhartt jacket" },
    "maxItems": { "title": "Max listings", "type": "integer", "default": 24, "minimum": 1, "maximum": 200 },
    "maxScrolls": { "title": "Max scrolls", "type": "integer", "default": 10, "minimum": 1, "maximum": 60 },
    "maxPrice": { "title": "Max price", "type": "integer", "nullable": true, "minimum": 0 },
    "proxyConfiguration": { "title": "Proxy", "type": "object", "editor": "proxy", "default": { "useApifyProxy": true, "apifyProxyGroups": ["RESIDENTIAL"] } }
  },
  "required": ["query"]
}
