{
  "title": "HiBid Auction Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "query": { "title": "Search query", "type": "string", "description": "What to search HiBid lots for.", "editor": "textfield", "prefill": "macbook" },
    "maxItems": { "title": "Max lots", "type": "integer", "default": 40, "minimum": 1, "maximum": 200 },
    "maxScrolls": { "title": "Max scrolls", "type": "integer", "default": 8, "minimum": 1, "maximum": 40 },
    "maxPrice": { "title": "Max current bid", "type": "integer", "nullable": true, "minimum": 0 },
    "proxyConfiguration": { "title": "Proxy", "type": "object", "editor": "proxy", "default": { "useApifyProxy": true, "apifyProxyGroups": ["RESIDENTIAL"] } }
  },
  "required": ["query"]
}
