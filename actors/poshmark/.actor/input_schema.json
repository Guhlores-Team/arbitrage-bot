{
  "title": "Poshmark Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "query": { "title": "Search query", "type": "string", "description": "What to search Poshmark for.", "editor": "textfield", "prefill": "lululemon define jacket" },
    "availability": { "title": "Availability", "type": "string", "description": "available = buy-side listings; sold = comps.", "editor": "select", "default": "available", "enum": ["available", "sold"], "enumTitles": ["Available (buy)", "Sold (comps)"] },
    "maxItems": { "title": "Max listings", "type": "integer", "default": 24, "minimum": 1, "maximum": 200 },
    "maxScrolls": { "title": "Max scrolls", "type": "integer", "default": 10, "minimum": 1, "maximum": 60 },
    "maxPrice": { "title": "Max price", "type": "integer", "nullable": true, "minimum": 0 },
    "proxyConfiguration": { "title": "Proxy", "type": "object", "editor": "proxy", "default": { "useApifyProxy": true, "apifyProxyGroups": ["RESIDENTIAL"] } }
  },
  "required": ["query"]
}
