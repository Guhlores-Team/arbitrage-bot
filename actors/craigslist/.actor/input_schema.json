{
  "title": "Craigslist Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "query": {
      "title": "Search query",
      "type": "string",
      "description": "What to search Craigslist for.",
      "editor": "textfield",
      "prefill": "nintendo switch"
    },
    "region": {
      "title": "Craigslist region",
      "type": "string",
      "description": "Region subdomain (e.g. sfbay, nyc, losangeles, seattle).",
      "editor": "textfield",
      "default": "sfbay"
    },
    "category": {
      "title": "Search category",
      "type": "string",
      "description": "Craigslist category code (sss = all for sale).",
      "editor": "textfield",
      "default": "sss"
    },
    "maxItems": {
      "title": "Max listings",
      "type": "integer",
      "description": "Stop after this many listings.",
      "default": 50,
      "minimum": 1,
      "maximum": 300
    },
    "maxPrice": {
      "title": "Max price",
      "type": "integer",
      "description": "Drop listings above this price (optional).",
      "nullable": true,
      "minimum": 0
    },
    "proxyConfiguration": {
      "title": "Proxy",
      "type": "object",
      "description": "Residential proxy is strongly recommended — Craigslist blocks datacenter IPs.",
      "editor": "proxy",
      "default": { "useApifyProxy": true, "apifyProxyGroups": ["RESIDENTIAL"] }
    }
  },
  "required": ["query"]
}
