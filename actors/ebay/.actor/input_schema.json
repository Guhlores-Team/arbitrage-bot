{
  "title": "eBay Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "query": { "title": "Search query", "type": "string", "description": "What to search eBay for.", "editor": "textfield", "prefill": "nintendo switch oled" },
    "maxItems": { "title": "Max listings", "type": "integer", "description": "Stop after this many listings.", "default": 40, "minimum": 1, "maximum": 200 },
    "sort": { "title": "Sort", "type": "string", "description": "Result order.", "editor": "select", "default": "price_asc", "enum": ["best_match", "price_asc", "newly_listed"], "enumTitles": ["Best match", "Price + shipping: lowest", "Newly listed"] },
    "condition": { "title": "Condition", "type": "string", "description": "Restrict by condition.", "editor": "select", "default": "any", "enum": ["any", "new", "used"], "enumTitles": ["Any", "New", "Used"] },
    "maxPrice": { "title": "Max price", "type": "integer", "description": "Drop listings above this price (optional).", "nullable": true, "minimum": 0 },
    "proxyConfiguration": { "title": "Proxy", "type": "object", "description": "Residential proxy recommended.", "editor": "proxy", "default": { "useApifyProxy": true, "apifyProxyGroups": ["RESIDENTIAL"] } }
  },
  "required": ["query"]
}
