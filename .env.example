# Copy to .env and fill in. All optional unless noted.
# Use placeholder values below — never commit real secrets.

# ── Comps / SerpApi ──────────────────────────────────────────────────────────
SERPAPI_KEY=                  # SerpApi key; needed for google/google_shopping/ebay-sold comps
SERPAPI_ENGINE=               # SerpApi engine override (default: google_shopping)
SERPAPI_EBAY_SOLD=            # "1" to query eBay sold listings via SerpApi (default: off)
SERPAPI_EBAY_DOMAIN=          # eBay domain for sold lookups (default: ebay.com)
SERPAPI_MIN_RESERVE=          # min SerpApi credits to keep in reserve (default: 0)
SERPAPI_MAX_PER_RUN=          # cap SerpApi calls per run to control spend (default: unlimited)
COMP_SOURCES=                 # comp markets, comma-sep e.g. "ebay-sold,google" (default: auto)
COMP_ROUTING=                 # per-category comp routing rules JSON (default: built-in)
COMP_CACHE_TTL_MIN=           # comp cache TTL in minutes (default: 60)
PRICECHARTING_TOKEN=          # PriceCharting API token (video games/cards comps)
KEEPA_API_KEY=                # Keepa API key (Amazon price history comps)
KEEPA_DOMAIN=                 # Keepa domain id (default: 1 = amazon.com)
EBAY_CLIENT_ID=               # eBay Browse API client id (active-listing comps)
EBAY_CLIENT_SECRET=           # eBay Browse API client secret
EBAY_USE_MOCK_COMPS=          # "1" to use mock eBay comps for local dev (default: off)
EBAY_COMP_SOURCE=             # eBay comp source mode (default: browse)
EBAY_BROWSE_ASK_TO_SOLD=      # "1" to derive sold-ish prices from ask prices (default: off)
EBAY_MARKETPLACE_ID=          # eBay marketplace id (default: EBAY_US)

# ── Sources / Scraping ───────────────────────────────────────────────────────
CRAIGSLIST_REGION=            # Craigslist subdomain region, e.g. "sfbay" (default: sfbay)
CRAIGSLIST_ENRICH=            # "1" to fetch detail pages for richer data (default: off)
FACEBOOK_MARKETPLACE_LOCATION=# FB Marketplace location slug/id (default: account default)
FACEBOOK_USER_DATA_DIR=       # persistent browser profile dir for logged-in FB sessions
FACEBOOK_COOKIES_FILE=        # path to exported FB cookies JSON (alt to user-data-dir)
FACEBOOK_HEADFUL=             # "1" to run FB scraper with a visible browser (default: headless)
OFFERUP_HEADFUL=              # "1" to run OfferUp scraper headful (default: headless)
MERCARI_HEADFUL=              # "1" to run Mercari scraper headful (default: headless)
STOCKX_API_TOKEN=             # StockX API token (real sneaker comps)
SCRAPER_LAT=                  # spoofed geolocation latitude for the browser
SCRAPER_LNG=                  # spoofed geolocation longitude for the browser
SCRAPER_PROXY=                # single proxy URL, e.g. http://user:pass@host:port
SCRAPER_PROXY_SOURCES=        # proxy pool sources/list JSON (default: none)
SCRAPER_IGNORE_HTTPS_ERRORS=  # "1" to ignore TLS errors (proxy MITM) (default: off)
SOURCE_TIMEOUT_MS=            # per-source scrape timeout in ms (default: built-in)

# ── Pipeline / Scoring ───────────────────────────────────────────────────────
PIPELINE_CONCURRENCY=         # how many listings to process in parallel (default: built-in)
PREFILTER_OFFTOPIC=           # "1" to drop obviously off-topic listings early (default: on)
MIN_MARGIN_PCT=               # min margin % for a deal to pass (default: built-in)
MIN_ABSOLUTE_PROFIT=          # min absolute $ profit to pass (default: built-in)
MIN_MATCH_CONFIDENCE=         # min comp-match confidence 0-1 to pass (default: built-in)
CONDITION_STEP_PCT=           # price discount per condition step (default: built-in)
RESALE_PERCENTILE=            # comp percentile used as resale estimate (default: built-in)

# ── Alerts ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # Telegram bot token for deal alerts
TELEGRAM_CHAT_ID=             # Telegram chat id to send alerts to
ALERT_WEBHOOK_URL=            # generic webhook URL for new-deal alerts

# ── Server ───────────────────────────────────────────────────────────────────
PORT=                         # HTTP port for the dashboard/API (default: 3000)
HOST=                         # bind host (default: 0.0.0.0)
WATCH_IN_SERVER=              # "1" to run the watch loop inside the server process (default: off)
SEED_DISCOVERY=               # "1" to auto-seed a starter discovery sweep (default: off)
STORE_FILE=                   # path to the JSON store (default: data/store.json)

# ── Identify / LLM ───────────────────────────────────────────────────────────
LLM_PROVIDER=                 # "openrouter" or "anthropic" (default: auto from keys)
OPENROUTER_API_KEY=           # OpenRouter API key
OPENROUTER_MODEL=             # OpenRouter model id (default: built-in)
ANTHROPIC_API_KEY=            # Anthropic API key
ANTHROPIC_MODEL=              # Anthropic model id (default: built-in)
IDENTIFY_MODEL=               # model id used for item identification (default: built-in)
MATCH_MODEL=                  # model id used for comp matching (default: built-in)

# ── Apify ────────────────────────────────────────────────────────────────────
APIFY_TOKEN=                  # Apify API token (apify_api_...)
APIFY_SOURCES=                # JSON array wiring Apify buy-source actors (failover)
APIFY_COMPS=                  # JSON array wiring Apify comp actors per market
APIFY_COMP_ACTOR=             # single Apify comp actor id (e.g. ebay-sold scraper)
APIFY_COMP_TASK=              # Apify comp task id (alt to APIFY_COMP_ACTOR)
APIFY_COMP_MARKET=            # comp market name for the actor (default: ebay-sold)
APIFY_COMP_QUERY_FIELD=       # actor input field that takes the search query (default: query)
APIFY_COMP_INPUT=             # extra static input JSON for the comp actor
APIFY_COMP_MAP=               # output field map JSON for the comp actor (default: 1:1)

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=                    # log verbosity: error|warn|info|debug (default: info)
DEBUG=                        # "1" to enable debug logging (alias of LOG_LEVEL=debug)
CALIBRATE_LIMIT=              # max items for `npm run calibrate` (default: built-in)
