# --- Anthropic (vision + text product identification, match verification) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- eBay Browse / Marketplace Insights API ---
# Create an app at https://developer.ebay.com/ -> get Client ID + Secret.
# Marketplace Insights (real SOLD comps) is gated: you must apply for access.
# Until approved, the eBay connector falls back to mock comps so the pipeline runs.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_USE_MOCK_COMPS=true

# --- Craigslist source connector ---
# Region subdomain, e.g. "sfbay", "newyork", "chicago".
CRAIGSLIST_REGION=sfbay

# --- Database (optional for the CLI demo; required once you persist) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/arbitrage

# --- Opportunity thresholds ---
MIN_MARGIN_PCT=0.25
MIN_ABSOLUTE_PROFIT=20
MIN_MATCH_CONFIDENCE=0.8
